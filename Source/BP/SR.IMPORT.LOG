SUBROUTINE SR.IMPORT.LOG(MESSAGE, LOG.PATH)
*=============================================================================
* SR.IMPORT.LOG
*
* Purpose:
*   Appends one timestamped line to today's import log file, keeping the
*   DATA.IMPORT screen limited.
*
* Parameters:
*   MESSAGE  (IN)  - Text to log (any embedded quotes/newlines are sanitized)
*   LOG.PATH (OUT) - Full path of today's log file that the line was written to
*
* Log files live in IMPORT.LOG.DIR, one per day: import_YYYY-MM-DD.log.
* Use PURGE.IMPORT.LOG to remove log files older than a chosen retention.
*=============================================================================
   $CATALOGUE

   $INCLUDE IMPORT.EQUATES

   CREATE.CMD = 'CREATE.FILE ' : IMPORT.LOG.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   OPEN IMPORT.LOG.DIR TO F.LOG.DIR ELSE
      LOG.PATH = ''
      RETURN
   END
   CLOSE F.LOG.DIR

   TODAY.STR = OCONV(DATE(), 'D4/YMD')
   TODAY.STR = CHANGE(TODAY.STR, '/', '-')
   LOG.PATH  = IMPORT.LOG.DIR : '/import_' : TODAY.STR : '.log'

   * Strip characters that would break out of the shell double-quotes this
   * line is written through (OWASP: never pass unsanitized text to EXECUTE).
   SAFE.MSG = MESSAGE
   SAFE.MSG = CHANGE(SAFE.MSG, CHAR(13), '')
   SAFE.MSG = CHANGE(SAFE.MSG, CHAR(10), ' ')
   SAFE.MSG = CHANGE(SAFE.MSG, '"', "'")
   SAFE.MSG = CHANGE(SAFE.MSG, '`', "'")
   SAFE.MSG = CHANGE(SAFE.MSG, '$', '')
   SAFE.MSG = CHANGE(SAFE.MSG, '\', '/')

   LINE.OUT = OCONV(TIME(), 'MTS') : '  ' : SAFE.MSG

   CMD = '!printf ' : "'%s\n' " : '"' : LINE.OUT : '" >> "' : LOG.PATH : '" 2>&1'
   EXECUTE CMD CAPTURING LOG.OUT

RETURN
*=============================================================================
END
