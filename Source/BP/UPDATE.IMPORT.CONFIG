PROGRAM UPDATE.IMPORT.CONFIG
*=============================================================================
* UPDATE.IMPORT.CONFIG
*
* Purpose:
*   Post-install upgrade utility for Data Import configuration.
*   Use this when new IMPORT.CONTROL dictionary items are introduced or
*   configuration records need to be refreshed.
*
* Scope:
*   - Ensures IMPORT.CONTROL exists
*   - Ensures IMPORT.CONTROL DICT items are present/updated
*   - Ensures IMPORT.CONFIG exists and STATUS remains READY
*   - Does NOT install Python dependencies (use INSTALL.IMPORT.CONFIG for that)
*=============================================================================

   $CATALOGUE

   $INCLUDE IMPORT.EQUATES

   EQU CONTROL.FILE TO 'IMPORT.CONTROL'
   EQU IMPORT.ARCHIVE.DIR TO 'import.archive'
   EQU SOURCE.ARCHIVE.DIR TO 'import.archive.source'
   EQU DIFF.ARCHIVE.DIR TO 'import.archive.diff'
   EQU CHANGELOG.ARCHIVE.DIR TO 'import.archive.changelog'
   EQU WORK.DIR TO 'import.work'

   ACCOUNT.NAME = @LOGNAME
   TODAY.DISP   = OCONV(DATE(), 'D2/')

   CRT @(-1)
   CRT 'AccountName :' : ACCOUNT.NAME : SPACE(30) : 'Date/Time:' : TODAY.DISP
   CRT
   CRT SPACE(24) : 'Update Data Import Configuration'
   CRT
   CRT
   CRT 'Purpose:'
   CRT '  - Apply config/dictionary upgrades'
   CRT '  - Keep IMPORT.CONTROL metadata aligned with IMPORT.EQUATES'
   CRT '  - Avoid full reinstall for schema/config updates'
   CRT
   CRT 'Notes:'
   CRT '  - This does not install Python dependencies'
   CRT '  - Existing control data records are preserved'
   CRT
   CRT
   CRT SPACE(34) : 'Are you ok to Proceed (Y/N) : ':
   INPUT PROCEED

   IF UPCASE(TRIM(PROCEED)) NE 'Y' THEN
      CRT
      CRT 'Update cancelled.'
      STOP
   END

   CREATE.CMD = 'CREATE.FILE ' : IMPORT.ARCHIVE.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   CREATE.CMD = 'CREATE.FILE ' : SOURCE.ARCHIVE.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   CREATE.CMD = 'CREATE.FILE ' : DIFF.ARCHIVE.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   CREATE.CMD = 'CREATE.FILE ' : CHANGELOG.ARCHIVE.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   CREATE.CMD = 'CREATE.FILE ' : WORK.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT

   CALL SR.CONTROL.DICT.BUILD(CONTROL.FILE, ERR.MSG)
   IF ERR.MSG # '' THEN
      CRT
      CRT 'IMPORT.CONTROL setup/refresh failed.'
      CRT ERR.MSG
      CRT 'Update did not complete.'
      STOP
   END

   CONFIG.OK = 1
   OPEN IMPORT.CONFIG.FILE TO F.CONFIG ELSE
      EXECUTE 'CREATE.FILE ' : IMPORT.CONFIG.FILE : ' DYNAMIC' CAPTURING CREATE.OUT
      OPEN IMPORT.CONFIG.FILE TO F.CONFIG ELSE CONFIG.OK = 0
   END

   IF CONFIG.OK = 0 THEN
      CRT
      CRT 'IMPORT.CONFIG could not be opened.'
      CRT 'Update did not complete.'
      STOP
   END

   WRITE IMPORT.CONFIG.READY TO F.CONFIG, IMPORT.CONFIG.ID
   CLOSE F.CONFIG

   CRT
   CRT 'Configuration update complete.'
   CRT 'IMPORT.CONTROL dictionary verified.'
   CRT 'IMPORT.CONFIG STATUS set to READY.'
   STOP

   END
