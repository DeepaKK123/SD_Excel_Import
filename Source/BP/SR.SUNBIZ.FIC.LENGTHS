SUBROUTINE SR.SUNBIZ.FIC.LENGTHS(LENGTHS.ROW)
*=============================================================================
* SR.SUNBIZ.FIC.LENGTHS
*
* Purpose:
*   Returns the field length for each column in SR.SUNBIZ.FIC.HEADER's
*   order (VM-delimited, same column positions - column 1 is the Record ID
*   field's own length). Used to size each DICT item's display FORMAT to
*   match the actual fixed-width layout instead of a generic guess.
*=============================================================================
   LENGTHS.ROW = 12 : @VM : 192 : @VM : 12
   LENGTHS.ROW := @VM : 40 : @VM : 40 : @VM : 28 : @VM : 2
   LENGTHS.ROW := @VM : 10 : @VM : 2 : @VM : 8
   LENGTHS.ROW := @VM : 5 : @VM : 1
   LENGTHS.ROW := @VM : 8 : @VM : 8
   LENGTHS.ROW := @VM : 5 : @VM : 14 : @VM : 1
   FOR OWN.NO = 1 TO 10
      LENGTHS.ROW := @VM : 12
      LENGTHS.ROW := @VM : 55
      LENGTHS.ROW := @VM : 1
      LENGTHS.ROW := @VM : 40
      LENGTHS.ROW := @VM : 28
      LENGTHS.ROW := @VM : 2
      LENGTHS.ROW := @VM : 10
      LENGTHS.ROW := @VM : 2
      LENGTHS.ROW := @VM : 9
      LENGTHS.ROW := @VM : 12
   NEXT OWN.NO
   RETURN
END
