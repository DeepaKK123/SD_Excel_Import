PROGRAM SD.IMPORT
*=============================================================================
* DATA.IMPORT
*
* Purpose:
*   Main driver for the Excel/CSV import pipeline. Displays an interactive
*   "Data Import and Maintenance" screen, then orchestrates, in order:
*     1. Gather run parameters (source, delimiter, MV file, mode)
*     2. Resolve the source (local path already, or remote)
*     3. Store a dated copy of the incoming file (for comparison history)
*     4. Parse the CSV/tab file into header + data rows
*     5. Build/update DICT items from the header row
*     6. Load or compare-and-update each data row into the MV file
*     7. Update the control record (current/prior load history)
* 
*=============================================================================
   
   $CATALOGUE

   $INCLUDE IMPORT.EQUATES

   * Common column width so every prompt's ':' lines up on screen.
   PROMPT.W = 56

   CRT @(-1)

   * -------------------------------------------------------------------
   * 1. Verify that the one-time import dependencies are configured.
   * -------------------------------------------------------------------
   CONFIGURED = 0
   OPEN IMPORT.CONFIG.FILE TO F.CONFIG THEN
      READ CONFIG.STATUS FROM F.CONFIG, IMPORT.CONFIG.ID THEN
         IF CONFIG.STATUS = IMPORT.CONFIG.READY THEN CONFIGURED = 1
      END
   END

   IF CONFIGURED NE 1 THEN
      CRT 'Data Import dependencies are not installed.'
      CRT 'Please run INSTALL.IMPORT.CONFIG first.'
      STOP
   END

   CREATE.CMD = 'CREATE.FILE ' : SOURCE.ARCHIVE.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   CREATE.CMD = 'CREATE.FILE ' : DIFF.ARCHIVE.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   CREATE.CMD = 'CREATE.FILE ' : WORK.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT

   * -------------------------------------------------------------------
   * 2. Header banner
   *    One SD account can be shared by multiple OS users, so the actual
   *    OS login (not just the account) is captured for the control record.
   * -------------------------------------------------------------------
   ACCOUNT.NAME = @LOGNAME
   EXECUTE '!whoami' CAPTURING OS.USER
   RUN.USER     = TRIM(OS.USER)
   TODAY.DISP   = OCONV(DATE(), 'D2/')

   SCREEN.INFO = ''
   SCREEN.INFO<1> = ACCOUNT.NAME
   SCREEN.INFO<2> = RUN.USER
   SRC.MODE = ''
   DRIVE.NAME = ''
   SOURCE.DIR = ''
   SOURCE.NAME = ''
   SOURCE.REF = ''
   DATA.FILE = ''
   CREATE.SYNONYMS = ''
   MODE.CODE = ''
   FORMAT.CODE = ''
   LAYOUT.CODE = ''
PAGE1.DISPLAY:
   CALL SR.SD.SCR.INPUT('@SD.PAGE1', 0, SCREEN.INFO, '', SCREEN.ACTION)
   PRINT @(42,7):SRC.MODE:
   IF SRC.MODE = 'R' THEN
      PRINT @(42,9):DRIVE.NAME:
   END ELSE
      PRINT @(42,9):SOURCE.DIR:
      PRINT @(42,11):SOURCE.NAME:
   END
   PRINT @(42,13):FORMAT.CODE:

   * -------------------------------------------------------------------
   * 3. Gather run parameters
   *    Typing 'End' (any case) at any prompt below exits immediately.
   * -------------------------------------------------------------------
SRC.MODE.RETRY:
   PROMPT.LBL = 'Source mode (Local=L, Remote=R) [L]'
   SRC.MODE.ERROR = ''
SRC.MODE.INPUT:
   CALL SR.SD.SCR.INPUT('@VALUE', 7, SRC.MODE, SRC.MODE.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN
      GOSUB CLEANUP.WORK
      STOP
   END
   ANSWER = SRC.MODE ; GOSUB CHECK.END
   IF TRIM(SRC.MODE) = '' THEN SRC.MODE = 'L'
   SRC.MODE = UPCASE(SRC.MODE)
   IF SRC.MODE # 'L' AND SRC.MODE # 'R' THEN
      SRC.MODE = ''
      SRC.MODE.ERROR = 'Please enter L for local or R for remote.'
      GOTO SRC.MODE.INPUT
   END

   IF SRC.MODE = 'R' THEN
REMOTE.NAME.RETRY:
      PROMPT.LBL = 'Remote file name'
      REMOTE.NAME.ERROR = ''
REMOTE.NAME.INPUT:
   CALL SR.SD.SCR.INPUT('@VALUE', 9, DRIVE.NAME, REMOTE.NAME.ERROR, INPUT.ACTION)
      IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
      ANSWER = DRIVE.NAME ; GOSUB CHECK.END
      DRIVE.NAME = TRIM(CHANGE(DRIVE.NAME, CHAR(13), ''))
      IF DRIVE.NAME = '' THEN
         DRIVE.NAME = ''
         REMOTE.NAME.ERROR = 'Remote file name is required.'
         GOTO REMOTE.NAME.INPUT
      END
      SOURCE.REF = 'DRIVE:' : DRIVE.NAME
   END ELSE
SOURCE.DIR.RETRY:
      PROMPT.LBL = 'Source directory'
      SOURCE.DIR.ERROR = ''
SOURCE.DIR.INPUT:
   CALL SR.SD.SCR.INPUT('@VALUE', 9, SOURCE.DIR, SOURCE.DIR.ERROR, INPUT.ACTION)
      IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
      ANSWER = SOURCE.DIR ; GOSUB CHECK.END
      SOURCE.DIR = TRIM(CHANGE(SOURCE.DIR, CHAR(13), ''))
      IF SOURCE.DIR = '' THEN
         SOURCE.DIR = ''
         SOURCE.DIR.ERROR = 'Source directory is required.'
         GOTO SOURCE.DIR.INPUT
      END

SOURCE.NAME.RETRY:
      PROMPT.LBL = 'Source file name'
      SOURCE.NAME.ERROR = ''
SOURCE.NAME.INPUT:
   CALL SR.SD.SCR.INPUT('@VALUE', 11, SOURCE.NAME, SOURCE.NAME.ERROR, INPUT.ACTION)
      IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
      ANSWER = SOURCE.NAME ; GOSUB CHECK.END
      SOURCE.NAME = TRIM(CHANGE(SOURCE.NAME, CHAR(13), ''))
      IF SOURCE.NAME = '' THEN
         SOURCE.NAME = ''
         SOURCE.NAME.ERROR = 'Source file name is required.'
         GOTO SOURCE.NAME.INPUT
      END

      IF SOURCE.DIR[LEN(SOURCE.DIR), 1] = '/' THEN
         SOURCE.REF = SOURCE.DIR : SOURCE.NAME
      END ELSE
         SOURCE.REF = SOURCE.DIR : '/' : SOURCE.NAME
      END
   END

FORMAT.CODE.RETRY:
   PROMPT.LBL = 'Format (C/T/S/P, P=Fixed Pos) [C]'
   FORMAT.CODE.ERROR = ''
FORMAT.CODE.INPUT:
   CALL SR.SD.SCR.INPUT('@VALUE', 13, FORMAT.CODE, FORMAT.CODE.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   ANSWER = FORMAT.CODE ; GOSUB CHECK.END
   IF TRIM(FORMAT.CODE) = '' THEN FORMAT.CODE = 'C'
   FORMAT.CODE = UPCASE(FORMAT.CODE)
   IF FORMAT.CODE # 'C' AND FORMAT.CODE # 'T' AND FORMAT.CODE # 'S' AND FORMAT.CODE # 'P' THEN
      FORMAT.CODE = ''
      FORMAT.CODE.ERROR = 'Please enter C, T, S, or P.'
      GOTO FORMAT.CODE.INPUT
   END

   IF FORMAT.CODE = 'P' THEN
      GOSUB LAYOUT.SELECT
      IF ERR.MSG NE '' THEN GOSUB CLEANUP.WORK ; STOP
   END ELSE
      LAYOUT.CODE = ''
   END

PAGE1.NAV:
   PROMPT.LBL = 'Enter F=Forward or END=Exit'
   PAGE.NAV.ERROR = ''
PAGE1.NAV.INPUT:
   CALL SR.SD.SCR.INPUT(PROMPT.LBL, 20, PAGE.ACTION, PAGE.NAV.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   PAGE.ACTION = UPCASE(TRIM(PAGE.ACTION))
   IF PAGE.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   IF PAGE.ACTION # 'F' AND PAGE.ACTION # 'FORWARD' THEN
      PAGE.ACTION = ''
      PAGE.NAV.ERROR = 'Enter F to continue or END to exit.'
      GOTO PAGE1.NAV.INPUT
   END

   * Excel conversion and the standard import CSV use comma separation;
   * fixed-position sources are read via dedicated SunBiz parsers instead.
   BEGIN CASE
      CASE FORMAT.CODE = 'T'
         DELIM = 'TAB'
      CASE FORMAT.CODE = 'S'
         DELIM = 'SPACE'
      CASE 1
         DELIM = 'COMMA'
   END CASE

   * -------------------------------------------------------------------
   * 4. Resolve source (Local, or Remote)
   * -------------------------------------------------------------------
   SOURCE.UC = UPCASE(SOURCE.REF)
   NEEDS.FETCH = 0
   IF SRC.MODE = 'R' THEN NEEDS.FETCH = 1
   IF LEN(SOURCE.UC) >= 5 AND SOURCE.UC[LEN(SOURCE.UC) - 4, 5] = '.XLSX' THEN NEEDS.FETCH = 1
   IF LEN(SOURCE.UC) >= 4 AND SOURCE.UC[LEN(SOURCE.UC) - 3, 4] = '.XLS' THEN NEEDS.FETCH = 1

   IF NEEDS.FETCH THEN
      CALL SR.FILE.FETCH(SOURCE.REF, SOURCE.PATH, ERR.MSG)
      IF ERR.MSG NE '' THEN
         CRT 'SOURCE FETCH FAILED: ' : ERR.MSG
         GOSUB CLEANUP.WORK
         STOP
      END
   END ELSE
      SOURCE.PATH = SOURCE.REF
   END

   IF SOURCE.PATH[1, 9] # 'MANIFEST:' THEN
      OPENSEQ SOURCE.PATH TO F.SOURCE.CHECK ELSE
         CRT 'Source file not found: ' : SOURCE.PATH
         GOSUB CLEANUP.WORK
         STOP
      END
      CLOSESEQ F.SOURCE.CHECK
   END

   MANIFEST.MULTI.RUN = 0
   IF SOURCE.PATH[1, 9] = 'MANIFEST:' THEN
      MANIFEST.PATH = SOURCE.PATH[10, LEN(SOURCE.PATH) - 9]
      GOSUB SELECT.SHEET.FROM.MANIFEST
      IF ERR.MSG NE '' THEN
         CRT 'SHEET SELECTION FAILED: ' : ERR.MSG
         GOSUB CLEANUP.WORK
         STOP
      END
      IF MANIFEST.MULTI.RUN THEN
         GOSUB RUN.MANIFEST.IMPORTS
         GOSUB CLEANUP.WORK
         STOP
      END
   END

PAGE2.DISPLAY:
   CALL SR.SD.SCR.INPUT('@SD.PAGE2', 0, SCREEN.INFO, '', SCREEN.ACTION)
   PRINT @(42,7):DATA.FILE:
   PRINT @(42,9):CREATE.SYNONYMS:
   PRINT @(42,11):MODE.CODE:
TARGET.FILE.RETRY:
   PROMPT.LBL = 'Target MV file name'
   TARGET.FILE.ERROR = ''
TARGET.FILE.INPUT:
   CALL SR.SD.SCR.INPUT(PROMPT.LBL, 7, DATA.FILE, TARGET.FILE.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   ANSWER = DATA.FILE ; GOSUB CHECK.END
   DATA.FILE = TRIM(CHANGE(DATA.FILE, CHAR(13), ''))
   IF DATA.FILE = '' THEN
      DATA.FILE = ''
      TARGET.FILE.ERROR = 'Target MV file name is required.'
      GOTO TARGET.FILE.INPUT
   END
   CONTROL.ID = DATA.FILE

   PROMPT.LBL = 'Create DICT synonyms (Y/N) [N]'
   CREATE.SYN.ERROR = ''
CREATE.SYN.INPUT:
   CALL SR.SD.SCR.INPUT(PROMPT.LBL, 9, CREATE.SYNONYMS, CREATE.SYN.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   ANSWER = CREATE.SYNONYMS ; GOSUB CHECK.END
   IF TRIM(CREATE.SYNONYMS) = '' THEN CREATE.SYNONYMS = 'N'
   CREATE.SYNONYMS = UPCASE(CREATE.SYNONYMS)
   IF CREATE.SYNONYMS # 'Y' AND CREATE.SYNONYMS # 'N' THEN
      CREATE.SYNONYMS = ''
      CREATE.SYN.ERROR = 'Please enter Y or N.'
      GOTO CREATE.SYN.INPUT
   END
   * Synonym creation is currently disabled in SR.DICT.BUILD.

   GOSUB SHOW.LAST.LOAD

LOAD.MODE.RETRY:
   PROMPT.LBL = 'Load mode (Full=F, Update=U) [F]'
   LOAD.MODE.ERROR = ''
LOAD.MODE.INPUT:
   CALL SR.SD.SCR.INPUT(PROMPT.LBL, 11, MODE.CODE, LOAD.MODE.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   ANSWER = MODE.CODE ; GOSUB CHECK.END
   IF TRIM(MODE.CODE) = '' THEN MODE.CODE = 'F'
   IF UPCASE(MODE.CODE) = 'U' OR UPCASE(MODE.CODE) = 'UPDATE' THEN
      IF LAYOUT.CODE NE '' THEN
         MODE.CODE = ''
         LOAD.MODE.ERROR = 'Fixed-position sources only support Full Load (F).'
         GOTO LOAD.MODE.INPUT
      END
      FILE.TYPE = FT.UPDATE
   END ELSE IF UPCASE(MODE.CODE) = 'F' OR UPCASE(MODE.CODE) = 'FULL' THEN
      FILE.TYPE = FT.FULL
   END ELSE
      MODE.CODE = ''
      LOAD.MODE.ERROR = 'Please enter F for full load or U for update.'
      GOTO LOAD.MODE.INPUT
   END

PAGE2.NAV:
   PROMPT.LBL = 'Enter F=Forward, B=Back, or END=Exit'
   PAGE.NAV.ERROR = ''
PAGE2.NAV.INPUT:
   CALL SR.SD.SCR.INPUT(PROMPT.LBL, 20, PAGE.ACTION, PAGE.NAV.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   PAGE.ACTION = UPCASE(TRIM(PAGE.ACTION))
   IF PAGE.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   IF PAGE.ACTION = 'BACK' OR PAGE.ACTION = 'B' THEN GOTO PAGE1.DISPLAY
   IF PAGE.ACTION # 'F' AND PAGE.ACTION # 'FORWARD' THEN
      PAGE.ACTION = ''
      PAGE.NAV.ERROR = 'Enter F, B, or END.'
      GOTO PAGE2.NAV.INPUT
   END

PAGE3.DISPLAY:
   CALL SR.SD.SCR.INPUT('@SD.PAGE3', 0, SCREEN.INFO, '', SCREEN.ACTION)
   PRINT @(0,7):'Source: ' : SOURCE.REF:
   PRINT @(0,9):'Target: ' : DATA.FILE:
   PRINT @(0,11):'Mode: ' : FILE.TYPE:
   IF LAYOUT.CODE NE '' THEN
      PRINT @(0,13):'Format: Fixed Position (' : LAYOUT.CODE : ')':
   END ELSE
      PRINT @(0,13):'Format: ' : DELIM:
   END
   PRINT @(0,15):STR('-', 78):
   PROMPT.LBL = 'Enter P=Process, B=Back, or END=Exit'
   PROCEED.ERROR = ''
PROCEED.INPUT:
   CALL SR.SD.SCR.INPUT(PROMPT.LBL, 20, PROCEED, PROCEED.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   ANSWER = PROCEED ; GOSUB CHECK.END
   PROCEED = UPCASE(TRIM(PROCEED))
   IF PROCEED = 'BACK' OR PROCEED = 'B' THEN GOTO PAGE2.DISPLAY
   IF PROCEED = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   IF PROCEED # 'P' AND PROCEED # 'PROCESS' THEN
      PROCEED = ''
      PROCEED.ERROR = 'Please enter P, B, or END.'
      GOTO PROCEED.INPUT
   END

CONFIRM.PROCESS:
   PROMPT.LBL = 'Confirm processing (Y/N)'
   CONFIRM.ERROR = ''
CONFIRM.PROCESS.INPUT:
   CALL SR.SD.SCR.INPUT(PROMPT.LBL, 22, CONFIRM.PROCESS, CONFIRM.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   CONFIRM.PROCESS = UPCASE(TRIM(CONFIRM.PROCESS))
   IF CONFIRM.PROCESS = 'N' OR CONFIRM.PROCESS = 'NO' THEN GOTO PAGE3.DISPLAY
   IF CONFIRM.PROCESS # 'Y' AND CONFIRM.PROCESS # 'YES' THEN
      CONFIRM.PROCESS = ''
      CONFIRM.ERROR = 'Please enter Y to process or N to return to review.'
      GOTO CONFIRM.PROCESS.INPUT
   END

   CRT
   GOSUB IMPORT.CURRENT.SOURCE
   IF ERR.MSG NE '' THEN
      CRT 'IMPORT FAILED : ' : ERR.MSG
      GOSUB CLEANUP.WORK
      STOP
   END

   CRT STR('-', 60)
   CRT 'Import complete.'
   CRT 'Log file : ' : RUN.LOG.PATH : '  (view with IMPORT.LOG.VIEW)'
   GOSUB CLEANUP.WORK

   STOP

* -------------------------------------------------------------------
* Fixed-position source: show the supported layouts and let the operator
* pick one. Sets LAYOUT.CODE to 'CORP' or 'FIC'. 'B' returns to the format
* prompt (FORMAT.CODE is cleared so the operator can choose again).
* -------------------------------------------------------------------
LAYOUT.SELECT:
   ERR.MSG = ''
LAYOUT.SELECT.DISPLAY:
   CALL SR.SD.SCR.INPUT('@SD.LAYOUT.PAGE', 0, SCREEN.INFO, '', SCREEN.ACTION)
   PROMPT.LBL = 'Enter B=Back or END=Exit'
   LAYOUT.ERROR = ''
LAYOUT.SELECT.INPUT:
   CALL SR.SD.SCR.INPUT('@VALUE', 11, LAYOUT.CODE, LAYOUT.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN
      GOSUB CLEANUP.WORK
      ERR.MSG = 'Import cancelled by user.'
      RETURN
   END
   ANSWER = LAYOUT.CODE
   IF UPCASE(TRIM(LAYOUT.CODE)) = 'END' THEN
      GOSUB CLEANUP.WORK
      ERR.MSG = 'Import cancelled by user.'
      RETURN
   END
   IF UPCASE(TRIM(LAYOUT.CODE)) = 'B' OR UPCASE(TRIM(LAYOUT.CODE)) = 'BACK' THEN
      LAYOUT.CODE = ''
      FORMAT.CODE = ''
      GOTO PAGE1.DISPLAY
   END
   LAYOUT.CODE = UPCASE(TRIM(LAYOUT.CODE))
   IF LAYOUT.CODE = 'C' THEN LAYOUT.CODE = 'CORP'
   IF LAYOUT.CODE = 'F' THEN LAYOUT.CODE = 'FIC'
   IF LAYOUT.CODE # 'CORP' AND LAYOUT.CODE # 'FIC' THEN
      LAYOUT.CODE = ''
      LAYOUT.ERROR = 'Please enter C (Corp) or F (Fictitious Name).'
      GOTO LAYOUT.SELECT.INPUT
   END
RETURN

* -------------------------------------------------------------------
* Shared prompt guard: typing 'End' at any question exits the program.
* -------------------------------------------------------------------
CHECK.END:
   IF UPCASE(TRIM(ANSWER)) = 'END' THEN
      GOSUB CLEANUP.WORK
      CRT @(-1)
      STOP
   END
RETURN

CLEANUP.WORK:
   EXECUTE '!rm -rf "' : WORK.DIR : '"/* 2>&1' CAPTURING CLEANUP.OUT
RETURN

* -------------------------------------------------------------------
* Checklist for workbook manifest mode.
* Source remains one file per run; user chooses target MV files for all
* prepared sheet CSV files in a single execution.
* -------------------------------------------------------------------
SELECT.SHEET.FROM.MANIFEST:
   ERR.MSG = ''
   SHEET.COUNT = 0
   SHEET.NAME = ''
   SHEET.PATH = ''
   SHEET.ROWS = ''
   SHEET.SELECTED = ''

   OPENSEQ MANIFEST.PATH TO F.MANIFEST ELSE
      ERR.MSG = 'Cannot open workbook manifest: ' : MANIFEST.PATH
      RETURN
   END

   LOOP
      READSEQ MAN.LINE FROM F.MANIFEST ELSE EXIT

      IF MAN.LINE[LEN(MAN.LINE), 1] = CHAR(13) THEN
         MAN.LINE = MAN.LINE[1, LEN(MAN.LINE) - 1]
      END
      IF TRIM(MAN.LINE) = '' THEN CONTINUE

      SHEET.COUNT += 1
      SHEET.NAME<SHEET.COUNT> = FIELD(MAN.LINE, '|', 1)
      SHEET.PATH<SHEET.COUNT> = FIELD(MAN.LINE, '|', 2)
      SHEET.ROWS<SHEET.COUNT> = FIELD(MAN.LINE, '|', 3)
   REPEAT
   CLOSESEQ F.MANIFEST

   IF SHEET.COUNT = 0 THEN
      ERR.MSG = 'Workbook manifest had no importable sheets: ' : MANIFEST.PATH
      RETURN
   END

SHEET.PAGE2.DISPLAY:
   CALL SR.SD.SCR.INPUT('@SHEET.FORM', 0, SCREEN.INFO, '', SCREEN.ACTION)
   FOR SHEET.NO = 1 TO SHEET.COUNT
      PRINT @(2,6 + SHEET.NO):'[' : SHEET.NO : '] ' : SHEET.NAME<SHEET.NO> : ' (' : SHEET.ROWS<SHEET.NO> : ' rows)':
   NEXT SHEET.NO

   SHEET.INPUT.ROW = 8 + SHEET.COUNT
   IF SHEET.INPUT.ROW > 18 THEN SHEET.INPUT.ROW = 18
   PRINT @(0,SHEET.INPUT.ROW):@(-3):'Select sheets (ALL or 1,2)':
   PRINT @(0,20):@(-3):'Enter F=Forward, B=Back, or END=Exit':
SHEET.SEL.RETRY:
   SHEET.SEL.ERROR = ''
SHEET.SEL.INPUT:
   CALL SR.SD.SCR.INPUT('@SHEET.VALUE', SHEET.INPUT.ROW, SHEET.SEL.INP, SHEET.SEL.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   ANSWER = SHEET.SEL.INP ; GOSUB CHECK.END
   SHEET.SEL.INP = UPCASE(TRIM(CHANGE(SHEET.SEL.INP, CHAR(13), '')))
   IF SHEET.SEL.INP = '' OR SHEET.SEL.INP = 'ALL' THEN
      FOR SHEET.NO = 1 TO SHEET.COUNT
         SHEET.SELECTED<SHEET.NO> = 1
      NEXT SHEET.NO
   END ELSE
      FOR SHEET.NO = 1 TO SHEET.COUNT
         SHEET.SELECTED<SHEET.NO> = 0
      NEXT SHEET.NO
      NUM.SELS = DCOUNT(SHEET.SEL.INP, ',')
      VALID.SEL = 1
      FOR S.IDX = 1 TO NUM.SELS
         SEL.VAL = TRIM(FIELD(SHEET.SEL.INP, ',', S.IDX))
         IF NUM(SEL.VAL) AND SEL.VAL >= 1 AND SEL.VAL <= SHEET.COUNT THEN
            SHEET.SELECTED<SEL.VAL> = 1
         END ELSE
            VALID.SEL = 0
         END
      NEXT S.IDX
      IF NOT(VALID.SEL) THEN
         SHEET.SEL.INP = ''
         SHEET.SEL.ERROR = 'Enter sheet numbers between 1 and ' : SHEET.COUNT : ', or ALL.'
         GOTO SHEET.SEL.INPUT
      END
   END

SHEET.NAV.INPUT:
   CALL SR.SD.SCR.INPUT('@SHEET.VALUE', 20, SHEET.ACTION, '', INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   SHEET.ACTION = UPCASE(TRIM(CHANGE(SHEET.ACTION, CHAR(13), '')))
   IF SHEET.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   IF SHEET.ACTION = 'B' OR SHEET.ACTION = 'BACK' THEN GOTO PAGE1.DISPLAY
   IF SHEET.ACTION # 'F' AND SHEET.ACTION # 'FORWARD' THEN
      SHEET.ACTION = ''
      SHEET.SEL.ERROR = 'Enter F to continue, B to go back, or END to exit.'
      GOTO SHEET.SEL.INPUT
   END

   SELECTED.COUNT = 0
   FOR SHEET.NO = 1 TO SHEET.COUNT
      IF SHEET.SELECTED<SHEET.NO> THEN SELECTED.COUNT += 1
   NEXT SHEET.NO
   IF SELECTED.COUNT = 0 THEN
      ERR.MSG = 'No sheets selected.'
      RETURN
   END

SHEET.PAGE3.DISPLAY:
   CALL SR.SD.SCR.INPUT('@SD.PAGE3.SETUP', 0, SCREEN.INFO, '', SCREEN.ACTION)
   DETAIL.INPUT.ROW = 7

   RUN.COUNT = 0
   RUN.SHEET.NAME = ''
   RUN.SOURCE.PATH = ''
   RUN.TARGET.FILE = ''
   RUN.MODE = ''

   FOR SHEET.NO = 1 TO SHEET.COUNT
      IF NOT(SHEET.SELECTED<SHEET.NO>) THEN CONTINUE
TARGET.RETRY:
      TARGET.NAME = ''
      THIS.MODE = ''
      TARGET.ERROR = ''
TARGET.INPUT:
      PROMPT.LBL = 'Target MV file for [' : SHEET.NO : '] ' : SHEET.NAME<SHEET.NO> : ' : '
         CALL SR.SD.SCR.INPUT(PROMPT.LBL, DETAIL.INPUT.ROW, TARGET.NAME, TARGET.ERROR, INPUT.ACTION)
      IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
      ANSWER = TARGET.NAME ; GOSUB CHECK.END
      TARGET.NAME = TRIM(CHANGE(TARGET.NAME, CHAR(13), ''))
      IF TARGET.NAME = '' THEN
         TARGET.ERROR = 'Target MV file name is required.'
         GOTO TARGET.INPUT
      END
      FOR EXISTING.NO = 1 TO RUN.COUNT
         IF UPCASE(RUN.TARGET.FILE<EXISTING.NO>) = UPCASE(TARGET.NAME) THEN
            TARGET.NAME = ''
            TARGET.ERROR = 'This target was already assigned to another sheet.'
            GOTO TARGET.INPUT
         END
      NEXT EXISTING.NO

      * Check if target has prior history to recommend appropriate load mode
      TARGET.HAS.HISTORY = 0
      OPEN CONTROL.FILE TO F.CTRL.CHECK THEN
         READ PRIOR.REC FROM F.CTRL.CHECK, TARGET.NAME THEN
            TARGET.HAS.HISTORY = 1
            LAST.SK = PRIOR.REC<CTRL.CURR.SKIPPED>
            IF LAST.SK = '' THEN LAST.SK = PRIOR.REC<CTRL.CURR.SKIPPED.LEGACY>
            PRINT @(0,DETAIL.INPUT.ROW + 2):@(-3):'Previous load: ' : OCONV(PRIOR.REC<CTRL.CURR.DATE>, 'D4/') : ' at ' : OCONV(PRIOR.REC<CTRL.CURR.TIME>, 'MTS') : '  (' : PRIOR.REC<CTRL.CURR.TYPE> : ')':
            PRINT @(0,DETAIL.INPUT.ROW + 3):@(-3):'Results: Added ' : PRIOR.REC<CTRL.CURR.ADDED> : ' | Updated ' : PRIOR.REC<CTRL.CURR.CHANGED> : ' | Unchanged ' : LAST.SK:
         END
         CLOSE F.CTRL.CHECK
      END

      IF TARGET.HAS.HISTORY THEN
         DEF.MODE = 'U'
      END ELSE
         PRINT @(0,DETAIL.INPUT.ROW + 2):@(-3):'Previous load: none (new target)':
         PRINT @(0,DETAIL.INPUT.ROW + 3):@(-3):
         DEF.MODE = 'F'
      END

SHEET.MODE.RETRY:
   SHEET.MODE.ERROR = ''
SHEET.MODE.INPUT:
   PRINT @(0,DETAIL.INPUT.ROW + 5):@(-3):'Load mode (Full=F, Update=U) [' : DEF.MODE : ']':
   CALL SR.SD.SCR.INPUT('@VALUE', DETAIL.INPUT.ROW + 5, THIS.MODE, SHEET.MODE.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
      ANSWER = THIS.MODE ; GOSUB CHECK.END
      IF TRIM(THIS.MODE) = '' THEN THIS.MODE = DEF.MODE
      THIS.MODE = UPCASE(THIS.MODE)
      IF THIS.MODE = 'U' OR THIS.MODE = 'UPDATE' THEN
         SET.MODE = FT.UPDATE
      END ELSE IF THIS.MODE = 'F' OR THIS.MODE = 'FULL' THEN
         SET.MODE = FT.FULL
      END ELSE
         THIS.MODE = ''
         SHEET.MODE.ERROR = 'Please enter F for full load or U for update.'
         GOTO SHEET.MODE.INPUT
      END

DICT.SYN.INPUT:
      PRINT @(0,DETAIL.INPUT.ROW + 7):@(-3):'Create DICT synonyms (Y/N) [N]':
      CALL SR.SD.SCR.INPUT('@VALUE', DETAIL.INPUT.ROW + 7, CREATE.SYNONYMS, '', INPUT.ACTION)
      IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
      ANSWER = CREATE.SYNONYMS ; GOSUB CHECK.END
      IF TRIM(CREATE.SYNONYMS) = '' THEN CREATE.SYNONYMS = 'N'
      CREATE.SYNONYMS = UPCASE(CREATE.SYNONYMS)
      IF CREATE.SYNONYMS # 'Y' AND CREATE.SYNONYMS # 'N' THEN
         CREATE.SYNONYMS = ''
         GOTO DICT.SYN.INPUT
      END

      RUN.COUNT += 1
      RUN.SHEET.NAME<RUN.COUNT> = SHEET.NAME<SHEET.NO>
      RUN.SOURCE.PATH<RUN.COUNT> = SHEET.PATH<SHEET.NO>
      RUN.TARGET.FILE<RUN.COUNT> = TARGET.NAME
      RUN.MODE<RUN.COUNT> = SET.MODE
   NEXT SHEET.NO

   IF RUN.COUNT = 0 THEN
      ERR.MSG = 'No sheets selected for import.'
      RETURN
   END

   * --- Pre-flight validation pass -----------------------------------
   PREFLIGHT.OK = 1
   FOR RUN.NO = 1 TO RUN.COUNT
      OPENSEQ RUN.SOURCE.PATH<RUN.NO> TO F.VAL.CHECK THEN
         CLOSESEQ F.VAL.CHECK
      END ELSE
         CRT 'ERROR: Pre-flight check failed - cannot open prepared CSV: ' : RUN.SOURCE.PATH<RUN.NO>
         PREFLIGHT.OK = 0
      END
   NEXT RUN.NO

   IF NOT(PREFLIGHT.OK) THEN
      ERR.MSG = 'Pre-flight validation failed. Aborting import.'
      GOSUB CLEANUP.WORK
      RETURN
   END

WORKBOOK.PAGE3.DISPLAY:
   CALL SR.SD.SCR.INPUT('@SD.PAGE4', 0, SCREEN.INFO, '', SCREEN.ACTION)
   PRINT @(0,5):@(-3):'Workbook Import Plan:'
   PRINT @(0,6):STR('-', 78):
   FOR RUN.NO = 1 TO RUN.COUNT
      PRINT @(2,6 + RUN.NO):'[' : RUN.NO : '] ' : RUN.SHEET.NAME<RUN.NO> : ' -> ' : RUN.TARGET.FILE<RUN.NO> : '  [Mode: ' : RUN.MODE<RUN.NO> : ']':
   NEXT RUN.NO
   PRINT @(0,7 + RUN.COUNT):STR('-', 78):
   PROMPT.LBL = 'Enter P=Process, B=Back, or END=Exit'
   WORKBOOK.PROCEED.ERROR = ''
WORKBOOK.PROCEED.INPUT:
   CALL SR.SD.SCR.INPUT(PROMPT.LBL, 20, PROCEED, WORKBOOK.PROCEED.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   ANSWER = PROCEED ; GOSUB CHECK.END
   PROCEED = UPCASE(TRIM(PROCEED))
   IF PROCEED = 'B' OR PROCEED = 'BACK' THEN GOTO SHEET.PAGE2.DISPLAY
   IF PROCEED = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   IF PROCEED # 'P' AND PROCEED # 'PROCESS' THEN
      PROCEED = ''
      WORKBOOK.PROCEED.ERROR = 'Please enter P, B, or END.'
      GOTO WORKBOOK.PROCEED.INPUT
   END

   PROMPT.LBL = 'Confirm processing (Y/N)'
   WORKBOOK.CONFIRM.ERROR = ''
WORKBOOK.CONFIRM.INPUT:
   CALL SR.SD.SCR.INPUT(PROMPT.LBL, 22, CONFIRM.PROCESS, WORKBOOK.CONFIRM.ERROR, INPUT.ACTION)
   IF INPUT.ACTION = 'END' THEN GOSUB CLEANUP.WORK ; STOP
   CONFIRM.PROCESS = UPCASE(TRIM(CONFIRM.PROCESS))
   IF CONFIRM.PROCESS = 'N' OR CONFIRM.PROCESS = 'NO' THEN GOTO WORKBOOK.PAGE3.DISPLAY
   IF CONFIRM.PROCESS # 'Y' AND CONFIRM.PROCESS # 'YES' THEN
      CONFIRM.PROCESS = ''
      WORKBOOK.CONFIRM.ERROR = 'Please enter Y to process or N to return to review.'
      GOTO WORKBOOK.CONFIRM.INPUT
   END

   MANIFEST.MULTI.RUN = 1

RETURN

* -------------------------------------------------------------------
* Show last load summary (one line) for current CONTROL.ID.
* -------------------------------------------------------------------
SHOW.LAST.LOAD:
   LAST.LOAD.FOUND = 0
   OPEN CONTROL.FILE TO F.CONTROL THEN
      READ CONTROL.REC FROM F.CONTROL, CONTROL.ID THEN
         LAST.LOAD.FOUND = 1
      END
   END
   IF LAST.LOAD.FOUND THEN
      LAST.SKIPPED = CONTROL.REC<CTRL.CURR.SKIPPED>
      IF LAST.SKIPPED = '' THEN LAST.SKIPPED = CONTROL.REC<CTRL.CURR.SKIPPED.LEGACY>
      PRINT @(0,13):@(-3):'Last load: ' : OCONV(CONTROL.REC<CTRL.CURR.DATE>, 'D4/') : ' ' : OCONV(CONTROL.REC<CTRL.CURR.TIME>, 'MTS') : ' | ' : CONTROL.REC<CTRL.CURR.TYPE> : ' | Added: ' : CONTROL.REC<CTRL.CURR.ADDED> : ' | Updated: ' : CONTROL.REC<CTRL.CURR.CHANGED>:
   END ELSE
      PRINT @(0,13):@(-3):'Last load: none (new target)':
   END
RETURN

* -------------------------------------------------------------------
* Run all selected manifest sheet imports in one execution.
* -------------------------------------------------------------------
RUN.MANIFEST.IMPORTS:
   BATCH.OK = 0
   BATCH.FAIL = 0

   CRT
   CRT STR('-', 60)

   FOR RUN.NO = 1 TO RUN.COUNT
      SOURCE.PATH = RUN.SOURCE.PATH<RUN.NO>
      DATA.FILE   = RUN.TARGET.FILE<RUN.NO>
      CONTROL.ID  = DATA.FILE
      FILE.TYPE   = RUN.MODE<RUN.NO>

      CRT '[' : RUN.NO : '/' : RUN.COUNT : '] ' : RUN.SHEET.NAME<RUN.NO> : ' -> ' : DATA.FILE : ' (' : FILE.TYPE : ')'
      GOSUB SHOW.LAST.LOAD
      GOSUB IMPORT.CURRENT.SOURCE
      IF ERR.MSG NE '' THEN
         CRT '  FAILED: ' : ERR.MSG
         BATCH.FAIL += 1
         ERR.MSG = ''
         CRT
         CONTINUE
      END
      BATCH.OK += 1
      CRT
   NEXT RUN.NO

   CALL SR.SD.SCR.INPUT('@SD.RESULT', 0, SCREEN.INFO, '', SCREEN.ACTION)
   PRINT @(0,6):'Workbook import complete:':
   PRINT @(0,8):'Successful imports: ' : BATCH.OK:
   PRINT @(0,9):'Failed imports:     ' : BATCH.FAIL:
   PRINT @(0,11):'Review import activity with IMPORT.LOG.VIEW':
   PRINT @(0,20):'Press Enter to exit':
   INPUT @(24,20) BATCH.EXIT:
RETURN

* -------------------------------------------------------------------
* Import current SOURCE.PATH into current DATA.FILE.
* Requires CONTROL.ID, FILE.TYPE, RUN.USER, and DELIM.
* -------------------------------------------------------------------
IMPORT.CURRENT.SOURCE:
   ERR.MSG = ''
   CALL SR.IMPORT.LOG('------------- IMPORT STARTED -------------', RUN.LOG.PATH)
   CALL SR.IMPORT.LOG('Target: ' : DATA.FILE : ' | Mode: ' : FILE.TYPE, RUN.LOG.PATH)

   PREV.PATH = ''
   IF FILE.TYPE = FT.UPDATE AND LAST.LOAD.FOUND THEN
      PREV.SRC.DIR  = CONTROL.REC<CTRL.CURR.SRC.DIR>
      PREV.SRC.NAME = CONTROL.REC<CTRL.CURR.SRC.NAME>
      IF PREV.SRC.DIR NE '' AND PREV.SRC.NAME NE '' THEN
         CANDIDATE.PREV = PREV.SRC.DIR : '/' : PREV.SRC.NAME
         OPENSEQ CANDIDATE.PREV TO F.PREV.CHECK THEN
            PREV.PATH = CANDIDATE.PREV
            CLOSESEQ F.PREV.CHECK
         END
      END

      IF PREV.PATH = '' THEN
         CALL SR.IMPORT.LOG('No previous archive found for diffing - last load recorded source: ' : PREV.SRC.DIR : '/' : PREV.SRC.NAME : ' (missing, moved, or first load for this target)', RUN.LOG.PATH)
      END
   END

   IF FILE.TYPE = FT.UPDATE AND PREV.PATH = '' THEN
      IF LAST.LOAD.FOUND = 0 THEN
         ERR.MSG = 'UPDATE STOPPED: this is the first run. Select Full Load (F) first; no records were changed.'
      END ELSE
         ERR.MSG = 'UPDATE STOPPED: previous source archive is unavailable; no records were changed.'
      END
      CALL SR.IMPORT.LOG(ERR.MSG, RUN.LOG.PATH)
      GOSUB CLEANUP.WORK
      RETURN
   END

   USE.DIFF = 0

   IF FILE.TYPE = FT.UPDATE AND PREV.PATH NE '' THEN
      CALL SR.DATA.DIFF(PREV.PATH, SOURCE.PATH, DIFF.ARCHIVE.DIR, REPORT.PATH, ADDED.CNT, CHANGED.CNT.DIFF, DELETED.CNT, TOTAL.CNT, HEADER.ROW, ERR.MSG)
      IF ERR.MSG NE '' THEN
         ERR.MSG = 'UPDATE STOPPED: diff unavailable; no records were changed. ' : ERR.MSG
         CALL SR.IMPORT.LOG(ERR.MSG, RUN.LOG.PATH)
         RETURN
      END ELSE
         CALL SR.DATA.PARSE.MV(REPORT.PATH, DELIM, '', REPORT.HEADER, REPORT.ROWS, REPORT.COUNT, ERR.MSG)
         IF ERR.MSG NE '' THEN
            ERR.MSG = 'UPDATE STOPPED: diff report unreadable; no records were changed. ' : ERR.MSG
            CALL SR.IMPORT.LOG(ERR.MSG, RUN.LOG.PATH)
            RETURN
         END ELSE
            USE.DIFF  = 1
            ROW.COUNT = TOTAL.CNT
            CALL SR.IMPORT.LOG('Update comparison report: ' : REPORT.PATH, RUN.LOG.PATH)
            CALL SR.IMPORT.LOG('Source records: ' : ROW.COUNT : ' | Columns: ' : DCOUNT(HEADER.ROW, @VM) : ' | Mode: update', RUN.LOG.PATH)
            IF DELETED.CNT > 0 THEN
               CRT
               CRT 'WARNING: ' : DELETED.CNT : ' record(s) are missing from the new source.'
               CRT 'These records will be deleted from target: ' : DATA.FILE
               PROMPT.LBL = 'Confirm deletion (Y/N)                 : '
               CALL SR.SD.SCR.INPUT(PROMPT.LBL, 20, DELETE.PROCEED, '', INPUT.ACTION)
               IF INPUT.ACTION = 'END' THEN
                  ERR.MSG = 'Update cancelled by user.'
                  RETURN
               END
               ANSWER = DELETE.PROCEED ; GOSUB CHECK.END
               IF UPCASE(DELETE.PROCEED) NE 'Y' THEN
                  ERR.MSG = 'Update cancelled; no deleted records were applied.'
                  RETURN
               END
            END
         END
      END
   END

   STREAM.LAYOUT = 0
   IF NOT(USE.DIFF) THEN
      * CSV/delimited exports are parsed directly by MV BASIC. Fixed-position
      * SunBiz sources are streamed (read one line, write one record) further
      * below instead of being loaded into memory up front - their column
      * list is static, so it can be fetched without touching the file.
      * Python remains used by SR.FILE.FETCH only when an Excel workbook or
      * remote source needs preparing.
      BEGIN CASE
         CASE LAYOUT.CODE = 'CORP'
            CALL SR.SUNBIZ.CORP.HEADER(HEADER.ROW)
            STREAM.LAYOUT = 1
         CASE LAYOUT.CODE = 'FIC'
            CALL SR.SUNBIZ.FIC.HEADER(HEADER.ROW)
            STREAM.LAYOUT = 1
         CASE 1
            CALL SR.DATA.PARSE.MV(SOURCE.PATH, DELIM, '', HEADER.ROW, DATA.ROWS, ROW.COUNT, ERR.MSG)
      END CASE
      IF ERR.MSG NE '' THEN
         ERR.MSG = 'PARSE FAILED: ' : ERR.MSG
         RETURN
      END
      IF NOT(STREAM.LAYOUT) THEN
         CALL SR.IMPORT.LOG('Source records: ' : ROW.COUNT : ' | Columns: ' : DCOUNT(HEADER.ROW, @VM) : ' | Mode: full load', RUN.LOG.PATH)
      END ELSE
         * Cheap line count (no parsing, O(1) memory) so progress can show
         * '(done/total)' instead of just a running count.
         EXECUTE '!wc -l < "' : SOURCE.PATH : '" 2>/dev/null' CAPTURING WC.OUT
         TOTAL.LINES = TRIM(WC.OUT<1>)
         IF NOT(TOTAL.LINES MATCHES '1N0N') THEN TOTAL.LINES = 0
      END
   END

   * A completed earlier load leaves a control item. If that target can no
   * longer open, do not silently create a replacement after its VOC pointer
   * was removed or damaged.
   TARGET.KNOWN = 0
   OPEN CONTROL.FILE TO F.CONTROL.GUARD THEN
      READ CONTROL.GUARD.REC FROM F.CONTROL.GUARD, CONTROL.ID THEN
         TARGET.KNOWN = 1
      END
      CLOSE F.CONTROL.GUARD
   END

   OPEN DATA.FILE TO F.DATA ELSE
      IF TARGET.KNOWN THEN
         ERR.MSG = 'Cannot open existing target MV file: ' : DATA.FILE : '. Its VOC pointer may be missing or invalid; no replacement file was created.'
         CALL SR.IMPORT.LOG(ERR.MSG, RUN.LOG.PATH)
         RETURN
      END
      EXECUTE 'CREATE.FILE ' : DATA.FILE : ' DYNAMIC' CAPTURING CREATE.OUT
      OPEN DATA.FILE TO F.DATA ELSE
         ERR.MSG = 'Cannot create/open data file: ' : DATA.FILE : ' - ' : CREATE.OUT
         RETURN
      END
   END

   NEXT.ATTR = DATA.START.ATTR
   BEGIN CASE
      CASE LAYOUT.CODE = 'CORP'
         CALL SR.SUNBIZ.CORP.DICT.BUILD(DATA.FILE, NEXT.ATTR, ERR.MSG)
      CASE LAYOUT.CODE = 'FIC'
         CALL SR.SUNBIZ.FIC.DICT.BUILD(DATA.FILE, NEXT.ATTR, ERR.MSG)
      CASE 1
         CALL SR.DICT.BUILD(DATA.FILE, HEADER.ROW, NEXT.ATTR, ERR.MSG)
   END CASE
   IF ERR.MSG NE '' THEN
      CLOSE F.DATA
      ERR.MSG = 'DICT BUILD FAILED: ' : ERR.MSG
      RETURN
   END
   CALL SR.IMPORT.LOG('Data dictionary: ready (no field conversions).', RUN.LOG.PATH)

   NEW.COUNT     = 0
   CHANGED.COUNT = 0
   SKIPPED.COUNT = 0
   DELETED.COUNT = 0
   WRITE.ERROR.COUNT = 0
   DUP.COUNT     = 0

   * Unique per run; stamped onto each written record (reserved metadata
   * attr) so a second write to the same Record ID within THIS run can be
   * told apart from a normal overwrite of an older record from a prior
   * day's load.
   RUN.STAMP = OCONV(DATE(), 'D4/') : ' ' : OCONV(TIME(), 'MTS') : '.' : RND(999999)

   * Single in-place status line; overwritten (not scrolled) as batches
   * complete, starting immediately so the operator sees it before the
   * first batch finishes.
   PROGRESS.ROW = 22
   PRINT @(0, PROGRESS.ROW):@(-3):'Please wait... Import in progress...':

   IF USE.DIFF THEN
      NEW.COUNT     = ADDED.CNT
      CHANGED.COUNT = CHANGED.CNT.DIFF
      DELETED.COUNT = DELETED.CNT
      SKIPPED.COUNT = ROW.COUNT - ADDED.CNT - CHANGED.CNT.DIFF

      NUM.ROWS = DCOUNT(REPORT.ROWS, @FM)
      FOR ROW.NO = 1 TO NUM.ROWS
         ROW = REPORT.ROWS<ROW.NO>
         IF ROW<1, 1> = 'DELETE' THEN
            DEL.REC.ID = ROW<1, 2>
            DELETE.OK = 1
            DELETE F.DATA, DEL.REC.ID ON ERROR DELETE.OK = 0
            IF DELETE.OK = 0 THEN
               WRITE.ERROR.COUNT += 1
               CALL SR.IMPORT.LOG('DELETE FAILED (row ' : ROW.NO : ', REC.ID=' : DEL.REC.ID : ')', RUN.LOG.PATH)
            END
            CONTINUE
         END
         DEL ROW<1, 1>
         CALL SR.RECORD.BUILD(ROW, DATA.START.ATTR, REC.ID, NEW.REC, BUILD.ERR)
         IF BUILD.ERR NE '' THEN CONTINUE
         WRITE.OK = 1
         WRITE NEW.REC TO F.DATA, REC.ID ON ERROR WRITE.OK = 0
         IF WRITE.OK = 0 THEN
            WRITE.ERROR.COUNT += 1
            CALL SR.IMPORT.LOG('WRITE FAILED (row ' : ROW.NO : ', REC.ID=' : REC.ID : ')', RUN.LOG.PATH)
         END
      NEXT ROW.NO
   END ELSE IF STREAM.LAYOUT THEN
      * Fixed-position: read one line, build one record, write it - never
      * hold the whole file (which can be huge for SunBiz bulk downloads)
      * in memory at once.
      OPENSEQ SOURCE.PATH TO F.STREAM.SOURCE ELSE
         ERR.MSG = 'Cannot open fixed-position source: ' : SOURCE.PATH
         RETURN
      END
      ROW.NO = 0
      PROGRESS.EVERY = 10000
      SKIP.COUNT = 0
      BEGIN CASE
         CASE LAYOUT.CODE = 'CORP'
            EXPECTED.LEN = 1440
         CASE LAYOUT.CODE = 'FIC'
            EXPECTED.LEN = 2098
      END CASE
STREAM.READ.NEXT:
      READSEQ STREAM.LINE FROM F.STREAM.SOURCE ELSE GOTO STREAM.CLOSE
      IF TRIM(STREAM.LINE) = '' THEN
         SKIP.COUNT += 1
         GOTO STREAM.READ.NEXT
      END
      IF LEN(STREAM.LINE) < EXPECTED.LEN THEN
         SKIP.COUNT += 1
         CALL SR.IMPORT.LOG('SKIPPED non-data line (length=' : LEN(STREAM.LINE) : ', expected ' : EXPECTED.LEN : '): ' : STREAM.LINE[1, 80], RUN.LOG.PATH)
         GOTO STREAM.READ.NEXT
      END
      ROW.NO += 1
      IF MOD(ROW.NO, PROGRESS.EVERY) = 0 THEN
         BATCH.NO = ROW.NO / PROGRESS.EVERY
         PRINT @(0, PROGRESS.ROW):@(-3):'Please wait... Batch ' : BATCH.NO : ' | Import (' : ROW.NO : '/' : TOTAL.LINES : ') completed':
      END

      BEGIN CASE
         CASE LAYOUT.CODE = 'CORP'
            CALL SR.SUNBIZ.CORP.ROW(STREAM.LINE, ROW)
         CASE LAYOUT.CODE = 'FIC'
            CALL SR.SUNBIZ.FIC.ROW(STREAM.LINE, ROW)
      END CASE
      IF ROW<1, 1> = '' THEN GOTO STREAM.READ.NEXT

      CALL SR.RECORD.BUILD(ROW, DATA.START.ATTR, REC.ID, NEW.REC, BUILD.ERR)
      IF BUILD.ERR NE '' THEN GOTO STREAM.READ.NEXT

      * Same-run duplicate check: only a match on THIS run's stamp means a
      * genuine collision (two source rows resolved to the same Record ID
      * after SR.RECORD.BUILD's TRIM/space-to-hyphen cleanup); a match with
      * an older stamp is just a normal overwrite of a prior day's record.
      DUP.FOUND = 0
      READ EXISTING.REC FROM F.DATA, REC.ID THEN
         IF EXISTING.REC<DATA.RUN.STAMP.ATTR> = RUN.STAMP THEN
            DUP.FOUND = 1
            DUP.COUNT += 1
            CALL SR.IMPORT.LOG('DUPLICATE REC.ID within this run (row ' : ROW.NO : ', REC.ID=' : REC.ID : '): ' : STREAM.LINE[1, 80], RUN.LOG.PATH)
         END
      END
      NEW.REC<DATA.RUN.STAMP.ATTR> = RUN.STAMP

      WRITE.OK = 1
      WRITE NEW.REC TO F.DATA, REC.ID ON ERROR WRITE.OK = 0
      IF WRITE.OK = 0 THEN
         WRITE.ERROR.COUNT += 1
         CALL SR.IMPORT.LOG('WRITE FAILED (row ' : ROW.NO : ', REC.ID=' : REC.ID : ')', RUN.LOG.PATH)
         GOTO STREAM.READ.NEXT
      END
      NEW.COUNT += 1
      GOTO STREAM.READ.NEXT

STREAM.CLOSE:
      CLOSESEQ F.STREAM.SOURCE
      ROW.COUNT = ROW.NO
      CALL SR.IMPORT.LOG('Source records: ' : ROW.COUNT : ' | Columns: ' : DCOUNT(HEADER.ROW, @VM) : ' | Mode: full load (streamed) | Skipped non-data lines: ' : SKIP.COUNT, RUN.LOG.PATH)
      IF DUP.COUNT > 0 THEN
         CALL SR.IMPORT.LOG('WARNING: ' : DUP.COUNT : ' duplicate Record ID(s) overwritten within this run - see DUPLICATE lines above', RUN.LOG.PATH)
      END
   END ELSE
      NUM.ROWS = DCOUNT(DATA.ROWS, @FM)
      PROGRESS.EVERY = 10000

      FOR ROW.NO = 1 TO NUM.ROWS
         ROW = DATA.ROWS<ROW.NO>
         CALL SR.RECORD.BUILD(ROW, DATA.START.ATTR, REC.ID, NEW.REC, BUILD.ERR)
         IF BUILD.ERR NE '' THEN CONTINUE

         READ EXISTING.REC FROM F.DATA, REC.ID THEN
            IF EXISTING.REC<DATA.RUN.STAMP.ATTR> = RUN.STAMP THEN
               DUP.COUNT += 1
               CALL SR.IMPORT.LOG('DUPLICATE REC.ID within this run (row ' : ROW.NO : ', REC.ID=' : REC.ID : ')', RUN.LOG.PATH)
            END
         END
         NEW.REC<DATA.RUN.STAMP.ATTR> = RUN.STAMP

         WRITE.OK = 1
         WRITE NEW.REC TO F.DATA, REC.ID ON ERROR WRITE.OK = 0
         IF WRITE.OK = 0 THEN
            WRITE.ERROR.COUNT += 1
            CALL SR.IMPORT.LOG('WRITE FAILED (row ' : ROW.NO : ', REC.ID=' : REC.ID : ')', RUN.LOG.PATH)
            CONTINUE
         END
         NEW.COUNT += 1
         IF MOD(ROW.NO, PROGRESS.EVERY) = 0 THEN
            BATCH.NO = ROW.NO / PROGRESS.EVERY
            PRINT @(0, PROGRESS.ROW):@(-3):'Please wait... Batch ' : BATCH.NO : ' | Import (' : ROW.NO : '/' : NUM.ROWS : ') completed':
         END
      NEXT ROW.NO
      IF DUP.COUNT > 0 THEN
         CALL SR.IMPORT.LOG('WARNING: ' : DUP.COUNT : ' duplicate Record ID(s) overwritten within this run - see DUPLICATE lines above', RUN.LOG.PATH)
      END
   END

   IF WRITE.ERROR.COUNT > 0 THEN
      ERR.MSG = 'IMPORT FAILED: ' : WRITE.ERROR.COUNT : ' write/delete operation(s) failed; control history was not updated.'
      CALL SR.IMPORT.LOG(ERR.MSG, RUN.LOG.PATH)
      RETURN
   END

   CALL SR.LOAD.FILE(SOURCE.PATH, SOURCE.ARCHIVE.DIR, STORED.NAME, ERR.MSG)
   IF ERR.MSG NE '' THEN
      ERR.MSG = 'FILE STORE FAILED: ' : ERR.MSG
      RETURN
   END
   STORED.DIR = SOURCE.ARCHIVE.DIR
   STORED.PATH = STORED.DIR : '/' : STORED.NAME
   CALL SR.IMPORT.LOG('Source archive copy: ' : STORED.PATH, RUN.LOG.PATH)

   CALL SR.IMPORT.LOG('Import results | Added: ' : NEW.COUNT : ' | Updated: ' : CHANGED.COUNT : ' | Unchanged: ' : SKIPPED.COUNT : ' | Deleted: ' : DELETED.COUNT : ' | Errors: ' : WRITE.ERROR.COUNT : ' | Duplicates: ' : DUP.COUNT, RUN.LOG.PATH)
   CALL SR.IMPORT.LOG('------------- IMPORT COMPLETED -------------', RUN.LOG.PATH)

   RESULT.LINE = '  Result : New=' : NEW.COUNT : '  Changed=' : CHANGED.COUNT : '  Skipped=' : SKIPPED.COUNT
   IF DELETED.COUNT > 0 THEN RESULT.LINE := '  Deleted=' : DELETED.COUNT
   IF WRITE.ERROR.COUNT > 0 THEN RESULT.LINE := '  Errors=' : WRITE.ERROR.COUNT
   IF DUP.COUNT > 0 THEN RESULT.LINE := '  Duplicates=' : DUP.COUNT
   CRT RESULT.LINE

   CTRL.DIFF.PATH = ''
   IF USE.DIFF THEN
      CTRL.DIFF.PATH = REPORT.PATH
   END
   CALL SR.CONTROL.UPDATE(CONTROL.FILE, CONTROL.ID, FILE.TYPE, ROW.COUNT, NEW.COUNT, CHANGED.COUNT, DELETED.COUNT, CTRL.DIFF.PATH, RUN.USER, STORED.PATH, SKIPPED.COUNT, ERR.MSG)
   IF ERR.MSG NE '' THEN
      ERR.MSG = 'CONTROL UPDATE FAILED: ' : ERR.MSG
      RETURN
   END

   IF NEEDS.FETCH THEN
      EXECUTE '!rm -f "' : SOURCE.PATH : '" 2>&1' CAPTURING CLEANUP.OUT
   END
RETURN

   END