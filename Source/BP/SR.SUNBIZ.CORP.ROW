SUBROUTINE SR.SUNBIZ.CORP.ROW(LINE, ROW)
*=============================================================================
* SR.SUNBIZ.CORP.ROW
*
* Purpose:
*   Slices ONE already-read fixed-width SunBiz Corporate Data File line into
*   a VM-delimited ROW, using the FL.SUNBIZ.CORP.DATA column layout (each
*   field is a .POS/.LEN equate pair). Column 1 of ROW is the Record ID
*   (Corporation Number); columns 2+ match SR.SUNBIZ.CORP.HEADER's order.
*   Pure line-in/row-out - no file I/O - so callers can stream (read one
*   line, call this, write one record) without ever holding the whole file
*   in memory.
*
* Parameters:
*   LINE (IN)  - One raw fixed-width line (1440 characters)
*   ROW  (OUT) - VM-delimited fields, see SR.SUNBIZ.CORP.HEADER for order
*=============================================================================
   $CATALOGUE

   $INCLUDE FL.SUNBIZ.CORP.DATA

   ROW = ''
   ROW<1,1>  = TRIM(LINE[CORPORATION.NUMBER.POS, CORPORATION.NUMBER.LEN])
   ROW<1,2>  = TRIM(LINE[CORPORATION.NAME.POS, CORPORATION.NAME.LEN])
   ROW<1,3>  = TRIM(LINE[STATUS.POS, STATUS.LEN])
   ROW<1,4>  = TRIM(LINE[FILING.TYPE.POS, FILING.TYPE.LEN])
   ROW<1,5>  = TRIM(LINE[ADDRESS.1.POS, ADDRESS.1.LEN])
   ROW<1,6>  = TRIM(LINE[ADDRESS.2.POS, ADDRESS.2.LEN])
   ROW<1,7>  = TRIM(LINE[CITY.POS, CITY.LEN])
   ROW<1,8>  = TRIM(LINE[STATE.POS, STATE.LEN])
   ROW<1,9>  = TRIM(LINE[ZIP.POS, ZIP.LEN])
   ROW<1,10> = TRIM(LINE[COUNTRY.POS, COUNTRY.LEN])
   ROW<1,11> = TRIM(LINE[MAIL.ADDRESS.1.POS, MAIL.ADDRESS.1.LEN])
   ROW<1,12> = TRIM(LINE[MAIL.ADDRESS.2.POS, MAIL.ADDRESS.2.LEN])
   ROW<1,13> = TRIM(LINE[MAIL.CITY.POS, MAIL.CITY.LEN])
   ROW<1,14> = TRIM(LINE[MAIL.STATE.POS, MAIL.STATE.LEN])
   ROW<1,15> = TRIM(LINE[MAIL.ZIP.POS, MAIL.ZIP.LEN])
   ROW<1,16> = TRIM(LINE[MAIL.COUNTRY.POS, MAIL.COUNTRY.LEN])
   ROW<1,17> = TRIM(LINE[FILE.DATE.POS, FILE.DATE.LEN])
   ROW<1,18> = TRIM(LINE[FEI.NUMBER.POS, FEI.NUMBER.LEN])
   ROW<1,19> = TRIM(LINE[MORE.THAN.SIX.OFFICERS.FLAG.POS, MORE.THAN.SIX.OFFICERS.FLAG.LEN])
   ROW<1,20> = TRIM(LINE[LAST.TRANSACTION.DATE.POS, LAST.TRANSACTION.DATE.LEN])
   ROW<1,21> = TRIM(LINE[STATE.COUNTRY.POS, STATE.COUNTRY.LEN])
   ROW<1,22> = TRIM(LINE[REPORT.YEAR.1.POS, REPORT.YEAR.1.LEN])
   ROW<1,23> = TRIM(LINE[REPORT.DATE.1.POS, REPORT.DATE.1.LEN])
   ROW<1,24> = TRIM(LINE[REPORT.YEAR.2.POS, REPORT.YEAR.2.LEN])
   ROW<1,25> = TRIM(LINE[REPORT.DATE.2.POS, REPORT.DATE.2.LEN])
   ROW<1,26> = TRIM(LINE[REPORT.YEAR.3.POS, REPORT.YEAR.3.LEN])
   ROW<1,27> = TRIM(LINE[REPORT.DATE.3.POS, REPORT.DATE.3.LEN])
   ROW<1,28> = TRIM(LINE[REGISTERED.AGENT.NAME.POS, REGISTERED.AGENT.NAME.LEN])
   ROW<1,29> = TRIM(LINE[REGISTERED.AGENT.TYPE.POS, REGISTERED.AGENT.TYPE.LEN])
   ROW<1,30> = TRIM(LINE[REGISTERED.AGENT.ADDRESS.POS, REGISTERED.AGENT.ADDRESS.LEN])
   ROW<1,31> = TRIM(LINE[REGISTERED.AGENT.CITY.POS, REGISTERED.AGENT.CITY.LEN])
   ROW<1,32> = TRIM(LINE[REGISTERED.AGENT.STATE.POS, REGISTERED.AGENT.STATE.LEN])
   ROW<1,33> = TRIM(LINE[REGISTERED.AGENT.ZIP.4.POS, REGISTERED.AGENT.ZIP.4.LEN])

   ROW<1,34> = TRIM(LINE[OFFICER.1.TITLE.POS, OFFICER.1.TITLE.LEN])
   ROW<1,35> = TRIM(LINE[OFFICER.1.TYPE.POS, OFFICER.1.TYPE.LEN])
   ROW<1,36> = TRIM(LINE[OFFICER.1.NAME.POS, OFFICER.1.NAME.LEN])
   ROW<1,37> = TRIM(LINE[OFFICER.1.ADDRESS.POS, OFFICER.1.ADDRESS.LEN])
   ROW<1,38> = TRIM(LINE[OFFICER.1.CITY.POS, OFFICER.1.CITY.LEN])
   ROW<1,39> = TRIM(LINE[OFFICER.1.STATE.POS, OFFICER.1.STATE.LEN])
   ROW<1,40> = TRIM(LINE[OFFICER.1.ZIP.4.POS, OFFICER.1.ZIP.4.LEN])

   ROW<1,41> = TRIM(LINE[OFFICER.2.TITLE.POS, OFFICER.2.TITLE.LEN])
   ROW<1,42> = TRIM(LINE[OFFICER.2.TYPE.POS, OFFICER.2.TYPE.LEN])
   ROW<1,43> = TRIM(LINE[OFFICER.2.NAME.POS, OFFICER.2.NAME.LEN])
   ROW<1,44> = TRIM(LINE[OFFICER.2.ADDRESS.POS, OFFICER.2.ADDRESS.LEN])
   ROW<1,45> = TRIM(LINE[OFFICER.2.CITY.POS, OFFICER.2.CITY.LEN])
   ROW<1,46> = TRIM(LINE[OFFICER.2.STATE.POS, OFFICER.2.STATE.LEN])
   ROW<1,47> = TRIM(LINE[OFFICER.2.ZIP.4.POS, OFFICER.2.ZIP.4.LEN])

   ROW<1,48> = TRIM(LINE[OFFICER.3.TITLE.POS, OFFICER.3.TITLE.LEN])
   ROW<1,49> = TRIM(LINE[OFFICER.3.TYPE.POS, OFFICER.3.TYPE.LEN])
   ROW<1,50> = TRIM(LINE[OFFICER.3.NAME.POS, OFFICER.3.NAME.LEN])
   ROW<1,51> = TRIM(LINE[OFFICER.3.ADDRESS.POS, OFFICER.3.ADDRESS.LEN])
   ROW<1,52> = TRIM(LINE[OFFICER.3.CITY.POS, OFFICER.3.CITY.LEN])
   ROW<1,53> = TRIM(LINE[OFFICER.3.STATE.POS, OFFICER.3.STATE.LEN])
   ROW<1,54> = TRIM(LINE[OFFICER.3.ZIP.4.POS, OFFICER.3.ZIP.4.LEN])

   ROW<1,55> = TRIM(LINE[OFFICER.4.TITLE.POS, OFFICER.4.TITLE.LEN])
   ROW<1,56> = TRIM(LINE[OFFICER.4.TYPE.POS, OFFICER.4.TYPE.LEN])
   ROW<1,57> = TRIM(LINE[OFFICER.4.NAME.POS, OFFICER.4.NAME.LEN])
   ROW<1,58> = TRIM(LINE[OFFICER.4.ADDRESS.POS, OFFICER.4.ADDRESS.LEN])
   ROW<1,59> = TRIM(LINE[OFFICER.4.CITY.POS, OFFICER.4.CITY.LEN])
   ROW<1,60> = TRIM(LINE[OFFICER.4.STATE.POS, OFFICER.4.STATE.LEN])
   ROW<1,61> = TRIM(LINE[OFFICER.4.ZIP.4.POS, OFFICER.4.ZIP.4.LEN])

   ROW<1,62> = TRIM(LINE[OFFICER.5.TITLE.POS, OFFICER.5.TITLE.LEN])
   ROW<1,63> = TRIM(LINE[OFFICER.5.TYPE.POS, OFFICER.5.TYPE.LEN])
   ROW<1,64> = TRIM(LINE[OFFICER.5.NAME.POS, OFFICER.5.NAME.LEN])
   ROW<1,65> = TRIM(LINE[OFFICER.5.ADDRESS.POS, OFFICER.5.ADDRESS.LEN])
   ROW<1,66> = TRIM(LINE[OFFICER.5.CITY.POS, OFFICER.5.CITY.LEN])
   ROW<1,67> = TRIM(LINE[OFFICER.5.STATE.POS, OFFICER.5.STATE.LEN])
   ROW<1,68> = TRIM(LINE[OFFICER.5.ZIP.4.POS, OFFICER.5.ZIP.4.LEN])

   ROW<1,69> = TRIM(LINE[OFFICER.6.TITLE.POS, OFFICER.6.TITLE.LEN])
   ROW<1,70> = TRIM(LINE[OFFICER.6.TYPE.POS, OFFICER.6.TYPE.LEN])
   ROW<1,71> = TRIM(LINE[OFFICER.6.NAME.POS, OFFICER.6.NAME.LEN])
   ROW<1,72> = TRIM(LINE[OFFICER.6.ADDRESS.POS, OFFICER.6.ADDRESS.LEN])
   ROW<1,73> = TRIM(LINE[OFFICER.6.CITY.POS, OFFICER.6.CITY.LEN])
   ROW<1,74> = TRIM(LINE[OFFICER.6.STATE.POS, OFFICER.6.STATE.LEN])
   ROW<1,75> = TRIM(LINE[OFFICER.6.ZIP.4.POS, OFFICER.6.ZIP.4.LEN])

   RETURN
END
