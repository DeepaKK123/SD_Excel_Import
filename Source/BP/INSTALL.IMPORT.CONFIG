PROGRAM INSTALL.IMPORT.CONFIG
*=============================================================================
* INSTALL.IMPORT.CONFIG
*
* Purpose:
*   One-time setup entry point for the Data Import dependencies.
*   Installs and verifies the Python Excel dependency.
*
* Contract with DATA.IMPORT:
*   On successful installation, write 1 to IMPORT.CONFIG, STATUS.
*=============================================================================

   $CATALOGUE

   $INCLUDE SDPYFUNC.H

   $INCLUDE IMPORT.EQUATES

   EQU FETCH.SCRIPT TO 'scripts/sd_file_fetch.py'
   EQU CONTROL.FILE TO 'IMPORT.CONTROL'
   EQU IMPORT.ARCHIVE.DIR TO 'import.archive'
   EQU SOURCE.ARCHIVE.DIR TO 'import.archive.source'
   EQU DIFF.ARCHIVE.DIR TO 'import.archive.diff'
   EQU CHANGELOG.ARCHIVE.DIR TO 'import.archive.changelog'
   EQU WORK.DIR TO 'import.work'

   ACCOUNT.NAME = @LOGNAME
   TODAY.DISP   = OCONV(DATE(), 'D2/')

   CRT @(-1)
   CRT 'AccountName :' : ACCOUNT.NAME : SPACE(30) : 'Date/Time:' : TODAY.DISP
   CRT
   CRT SPACE(24) : 'Install Data Import Dependencies'
   CRT
   CRT
   CRT 'Purpose:'
   CRT '  - Check required Python dependencies'
   CRT '  - Install missing components'
   CRT '  - Mark Data Import as ready'
   CRT
   CRT 'Notes:'
   CRT '  - You may be prompted for admin credentials'
   CRT '  - Review install messages before continuing'
   CRT
   CRT
   CRT SPACE(34) : 'Are you ok to Proceed (Y/N) : ':
   INPUT PROCEED

   IF UPCASE(TRIM(PROCEED)) NE 'Y' THEN
      CRT
      CRT 'Installation cancelled.'
      STOP
   END

   CREATE.CMD = 'CREATE.FILE ' : IMPORT.ARCHIVE.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   CREATE.CMD = 'CREATE.FILE ' : SOURCE.ARCHIVE.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   CREATE.CMD = 'CREATE.FILE ' : DIFF.ARCHIVE.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   CREATE.CMD = 'CREATE.FILE ' : CHANGELOG.ARCHIVE.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT
   CREATE.CMD = 'CREATE.FILE ' : WORK.DIR : ' DIRECTORY'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT

   CREATE.CMD = 'CREATE.FILE ' : CONTROL.FILE : ' DYNAMIC'
   EXECUTE CREATE.CMD CAPTURING CREATE.OUT

   CRT
   CRT 'Installing Python Excel dependency (openpyxl)...'
   CRT 'Embedded Python will check the dependency before installing anything.'
   CRT

   IF NOT(PY_IS_INITIALIZED()) THEN
      PY.INIT.STATUS = PY_INITIALIZE()
   END
   PY.SET.STATUS = PY_STRSET('SD_SOURCE_REF', '--install-dependencies')
   PY.SET.STATUS = PY_STRSET('SD_STAGING_DIR', '')
   PY.RUN.STATUS = PY_RUNFILE(FETCH.SCRIPT)
   VERIFY.OUT = PY_GETATTR('SD_RESULT')

   IF INDEX(VERIFY.OUT, 'PYTHON_DEP_OK', 1) = 0 THEN
      CRT
      CRT 'Embedded Python dependency check failed.'
      CRT 'No configuration changes were made.'
      STOP
   END
     
   CALL SR.CONTROL.DICT.BUILD(CONTROL.FILE, ERR.MSG)
   IF ERR.MSG # '' THEN
      CRT
      CRT 'Python is installed, but IMPORT.CONTROL setup failed.'
      CRT ERR.MSG
      CRT 'STATUS was not updated.'
      STOP
   END

   * Mark the import subsystem ready only after Python verification succeeds.
   CONFIG.OK = 1
   OPEN IMPORT.CONFIG.FILE TO F.CONFIG ELSE
      EXECUTE 'CREATE.FILE ' : IMPORT.CONFIG.FILE : ' DYNAMIC' CAPTURING CREATE.OUT
      OPEN IMPORT.CONFIG.FILE TO F.CONFIG ELSE CONFIG.OK = 0
   END

   IF CONFIG.OK = 0 THEN
      CRT 'Python is installed, but IMPORT.CONFIG could not be opened.'
      CRT 'STATUS was not updated.'
      STOP
   END

   WRITE IMPORT.CONFIG.READY TO F.CONFIG, IMPORT.CONFIG.ID
   CRT
   CRT 'Dependencies installed successfully.'
   CRT 'IMPORT.CONTROL dictionary verified.'
   CRT 'Data Import is ready to run.'
   STOP

   END