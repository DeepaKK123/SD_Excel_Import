SUBROUTINE SR.SUNBIZ.FIC.ROW(LINE, ROW)
*=============================================================================
* SR.SUNBIZ.FIC.ROW
*
* Purpose:
*   Slices ONE already-read fixed-width SunBiz Fictitious Name Data File
*   line into a VM-delimited ROW, using the FL.SUNBIZ.FIC.DATA column
*   layout (each field is a .POS/.LEN equate pair). Column 1 of ROW is the
*   Record ID (Document Number); columns 2+ match SR.SUNBIZ.FIC.HEADER's
*   order. Pure line-in/row-out - no file I/O - so callers can stream (read
*   one line, call this, write one record) without ever holding the whole
*   file in memory.
*
* Parameters:
*   LINE (IN)  - One raw fixed-width line (2098 characters)
*   ROW  (OUT) - VM-delimited fields, see SR.SUNBIZ.FIC.HEADER for order
*=============================================================================
   $CATALOGUE

   $INCLUDE FL.SUNBIZ.FIC.DATA

   ROW = ''
   ROW<1,1>  = TRIM(LINE[DOCUMENT.NUMBER.POS, DOCUMENT.NUMBER.LEN])
   ROW<1,2>  = TRIM(LINE[FICTITIOUS.NAME.POS, FICTITIOUS.NAME.LEN])
   ROW<1,3>  = TRIM(LINE[COUNTY.POS, COUNTY.LEN])
   ROW<1,4>  = TRIM(LINE[ADDRESS.1.POS, ADDRESS.1.LEN])
   ROW<1,5>  = TRIM(LINE[ADDRESS.2.POS, ADDRESS.2.LEN])
   ROW<1,6>  = TRIM(LINE[CITY.POS, CITY.LEN])
   ROW<1,7>  = TRIM(LINE[STATE.POS, STATE.LEN])
   ROW<1,8>  = TRIM(LINE[ZIP.POS, ZIP.LEN])
   ROW<1,9>  = TRIM(LINE[COUNTRY.POS, COUNTRY.LEN])
   ROW<1,10> = TRIM(LINE[FILING.DATE.POS, FILING.DATE.LEN])
   ROW<1,11> = TRIM(LINE[NUMBER.OF.PAGES.FILED.POS, NUMBER.OF.PAGES.FILED.LEN])
   ROW<1,12> = TRIM(LINE[STATUS.POS, STATUS.LEN])
   ROW<1,13> = TRIM(LINE[CANCELATION.DATE.POS, CANCELATION.DATE.LEN])
   ROW<1,14> = TRIM(LINE[EXPIRATION.DATE.POS, EXPIRATION.DATE.LEN])
   ROW<1,15> = TRIM(LINE[NUMBER.OF.OWNERS.POS, NUMBER.OF.OWNERS.LEN])
   ROW<1,16> = TRIM(LINE[FEI.NUMBER.POS, FEI.NUMBER.LEN])
   ROW<1,17> = TRIM(LINE[MORE.THAN.TEN.OWNERS.FLAG.POS, MORE.THAN.TEN.OWNERS.FLAG.LEN])

   ROW<1,18> = TRIM(LINE[OWNER.1.DOCUMENT.NUMBER.POS, OWNER.1.DOCUMENT.NUMBER.LEN])
   ROW<1,19> = TRIM(LINE[OWNER.1.NAME.POS, OWNER.1.NAME.LEN])
   ROW<1,20> = TRIM(LINE[OWNER.1.NAME.FORMAT.POS, OWNER.1.NAME.FORMAT.LEN])
   ROW<1,21> = TRIM(LINE[OWNER.1.ADDRESS.POS, OWNER.1.ADDRESS.LEN])
   ROW<1,22> = TRIM(LINE[OWNER.1.CITY.POS, OWNER.1.CITY.LEN])
   ROW<1,23> = TRIM(LINE[OWNER.1.STATE.POS, OWNER.1.STATE.LEN])
   ROW<1,24> = TRIM(LINE[OWNER.1.ZIP.POS, OWNER.1.ZIP.LEN])
   ROW<1,25> = TRIM(LINE[OWNER.1.COUNTRY.POS, OWNER.1.COUNTRY.LEN])
   ROW<1,26> = TRIM(LINE[OWNER.1.FEI.NUMBER.POS, OWNER.1.FEI.NUMBER.LEN])
   ROW<1,27> = TRIM(LINE[OWNER.1.CHARTER.NUMBER.POS, OWNER.1.CHARTER.NUMBER.LEN])

   ROW<1,28> = TRIM(LINE[OWNER.2.DOCUMENT.NUMBER.POS, OWNER.2.DOCUMENT.NUMBER.LEN])
   ROW<1,29> = TRIM(LINE[OWNER.2.NAME.POS, OWNER.2.NAME.LEN])
   ROW<1,30> = TRIM(LINE[OWNER.2.NAME.FORMAT.POS, OWNER.2.NAME.FORMAT.LEN])
   ROW<1,31> = TRIM(LINE[OWNER.2.ADDRESS.POS, OWNER.2.ADDRESS.LEN])
   ROW<1,32> = TRIM(LINE[OWNER.2.CITY.POS, OWNER.2.CITY.LEN])
   ROW<1,33> = TRIM(LINE[OWNER.2.STATE.POS, OWNER.2.STATE.LEN])
   ROW<1,34> = TRIM(LINE[OWNER.2.ZIP.POS, OWNER.2.ZIP.LEN])
   ROW<1,35> = TRIM(LINE[OWNER.2.COUNTRY.POS, OWNER.2.COUNTRY.LEN])
   ROW<1,36> = TRIM(LINE[OWNER.2.FEI.NUMBER.POS, OWNER.2.FEI.NUMBER.LEN])
   ROW<1,37> = TRIM(LINE[OWNER.2.CHARTER.NUMBER.POS, OWNER.2.CHARTER.NUMBER.LEN])

   ROW<1,38> = TRIM(LINE[OWNER.3.DOCUMENT.NUMBER.POS, OWNER.3.DOCUMENT.NUMBER.LEN])
   ROW<1,39> = TRIM(LINE[OWNER.3.NAME.POS, OWNER.3.NAME.LEN])
   ROW<1,40> = TRIM(LINE[OWNER.3.NAME.FORMAT.POS, OWNER.3.NAME.FORMAT.LEN])
   ROW<1,41> = TRIM(LINE[OWNER.3.ADDRESS.POS, OWNER.3.ADDRESS.LEN])
   ROW<1,42> = TRIM(LINE[OWNER.3.CITY.POS, OWNER.3.CITY.LEN])
   ROW<1,43> = TRIM(LINE[OWNER.3.STATE.POS, OWNER.3.STATE.LEN])
   ROW<1,44> = TRIM(LINE[OWNER.3.ZIP.POS, OWNER.3.ZIP.LEN])
   ROW<1,45> = TRIM(LINE[OWNER.3.COUNTRY.POS, OWNER.3.COUNTRY.LEN])
   ROW<1,46> = TRIM(LINE[OWNER.3.FEI.NUMBER.POS, OWNER.3.FEI.NUMBER.LEN])
   ROW<1,47> = TRIM(LINE[OWNER.3.CHARTER.NUMBER.POS, OWNER.3.CHARTER.NUMBER.LEN])

   ROW<1,48> = TRIM(LINE[OWNER.4.DOCUMENT.NUMBER.POS, OWNER.4.DOCUMENT.NUMBER.LEN])
   ROW<1,49> = TRIM(LINE[OWNER.4.NAME.POS, OWNER.4.NAME.LEN])
   ROW<1,50> = TRIM(LINE[OWNER.4.NAME.FORMAT.POS, OWNER.4.NAME.FORMAT.LEN])
   ROW<1,51> = TRIM(LINE[OWNER.4.ADDRESS.POS, OWNER.4.ADDRESS.LEN])
   ROW<1,52> = TRIM(LINE[OWNER.4.CITY.POS, OWNER.4.CITY.LEN])
   ROW<1,53> = TRIM(LINE[OWNER.4.STATE.POS, OWNER.4.STATE.LEN])
   ROW<1,54> = TRIM(LINE[OWNER.4.ZIP.POS, OWNER.4.ZIP.LEN])
   ROW<1,55> = TRIM(LINE[OWNER.4.COUNTRY.POS, OWNER.4.COUNTRY.LEN])
   ROW<1,56> = TRIM(LINE[OWNER.4.FEI.NUMBER.POS, OWNER.4.FEI.NUMBER.LEN])
   ROW<1,57> = TRIM(LINE[OWNER.4.CHARTER.NUMBER.POS, OWNER.4.CHARTER.NUMBER.LEN])

   ROW<1,58> = TRIM(LINE[OWNER.5.DOCUMENT.NUMBER.POS, OWNER.5.DOCUMENT.NUMBER.LEN])
   ROW<1,59> = TRIM(LINE[OWNER.5.NAME.POS, OWNER.5.NAME.LEN])
   ROW<1,60> = TRIM(LINE[OWNER.5.NAME.FORMAT.POS, OWNER.5.NAME.FORMAT.LEN])
   ROW<1,61> = TRIM(LINE[OWNER.5.ADDRESS.POS, OWNER.5.ADDRESS.LEN])
   ROW<1,62> = TRIM(LINE[OWNER.5.CITY.POS, OWNER.5.CITY.LEN])
   ROW<1,63> = TRIM(LINE[OWNER.5.STATE.POS, OWNER.5.STATE.LEN])
   ROW<1,64> = TRIM(LINE[OWNER.5.ZIP.POS, OWNER.5.ZIP.LEN])
   ROW<1,65> = TRIM(LINE[OWNER.5.COUNTRY.POS, OWNER.5.COUNTRY.LEN])
   ROW<1,66> = TRIM(LINE[OWNER.5.FEI.NUMBER.POS, OWNER.5.FEI.NUMBER.LEN])
   ROW<1,67> = TRIM(LINE[OWNER.5.CHARTER.NUMBER.POS, OWNER.5.CHARTER.NUMBER.LEN])

   ROW<1,68> = TRIM(LINE[OWNER.6.DOCUMENT.NUMBER.POS, OWNER.6.DOCUMENT.NUMBER.LEN])
   ROW<1,69> = TRIM(LINE[OWNER.6.NAME.POS, OWNER.6.NAME.LEN])
   ROW<1,70> = TRIM(LINE[OWNER.6.NAME.FORMAT.POS, OWNER.6.NAME.FORMAT.LEN])
   ROW<1,71> = TRIM(LINE[OWNER.6.ADDRESS.POS, OWNER.6.ADDRESS.LEN])
   ROW<1,72> = TRIM(LINE[OWNER.6.CITY.POS, OWNER.6.CITY.LEN])
   ROW<1,73> = TRIM(LINE[OWNER.6.STATE.POS, OWNER.6.STATE.LEN])
   ROW<1,74> = TRIM(LINE[OWNER.6.ZIP.POS, OWNER.6.ZIP.LEN])
   ROW<1,75> = TRIM(LINE[OWNER.6.COUNTRY.POS, OWNER.6.COUNTRY.LEN])
   ROW<1,76> = TRIM(LINE[OWNER.6.FEI.NUMBER.POS, OWNER.6.FEI.NUMBER.LEN])
   ROW<1,77> = TRIM(LINE[OWNER.6.CHARTER.NUMBER.POS, OWNER.6.CHARTER.NUMBER.LEN])

   ROW<1,78> = TRIM(LINE[OWNER.7.DOCUMENT.NUMBER.POS, OWNER.7.DOCUMENT.NUMBER.LEN])
   ROW<1,79> = TRIM(LINE[OWNER.7.NAME.POS, OWNER.7.NAME.LEN])
   ROW<1,80> = TRIM(LINE[OWNER.7.NAME.FORMAT.POS, OWNER.7.NAME.FORMAT.LEN])
   ROW<1,81> = TRIM(LINE[OWNER.7.ADDRESS.POS, OWNER.7.ADDRESS.LEN])
   ROW<1,82> = TRIM(LINE[OWNER.7.CITY.POS, OWNER.7.CITY.LEN])
   ROW<1,83> = TRIM(LINE[OWNER.7.STATE.POS, OWNER.7.STATE.LEN])
   ROW<1,84> = TRIM(LINE[OWNER.7.ZIP.POS, OWNER.7.ZIP.LEN])
   ROW<1,85> = TRIM(LINE[OWNER.7.COUNTRY.POS, OWNER.7.COUNTRY.LEN])
   ROW<1,86> = TRIM(LINE[OWNER.7.FEI.NUMBER.POS, OWNER.7.FEI.NUMBER.LEN])
   ROW<1,87> = TRIM(LINE[OWNER.7.CHARTER.NUMBER.POS, OWNER.7.CHARTER.NUMBER.LEN])

   ROW<1,88> = TRIM(LINE[OWNER.8.DOCUMENT.NUMBER.POS, OWNER.8.DOCUMENT.NUMBER.LEN])
   ROW<1,89> = TRIM(LINE[OWNER.8.NAME.POS, OWNER.8.NAME.LEN])
   ROW<1,90> = TRIM(LINE[OWNER.8.NAME.FORMAT.POS, OWNER.8.NAME.FORMAT.LEN])
   ROW<1,91> = TRIM(LINE[OWNER.8.ADDRESS.POS, OWNER.8.ADDRESS.LEN])
   ROW<1,92> = TRIM(LINE[OWNER.8.CITY.POS, OWNER.8.CITY.LEN])
   ROW<1,93> = TRIM(LINE[OWNER.8.STATE.POS, OWNER.8.STATE.LEN])
   ROW<1,94> = TRIM(LINE[OWNER.8.ZIP.POS, OWNER.8.ZIP.LEN])
   ROW<1,95> = TRIM(LINE[OWNER.8.COUNTRY.POS, OWNER.8.COUNTRY.LEN])
   ROW<1,96> = TRIM(LINE[OWNER.8.FEI.NUMBER.POS, OWNER.8.FEI.NUMBER.LEN])
   ROW<1,97> = TRIM(LINE[OWNER.8.CHARTER.NUMBER.POS, OWNER.8.CHARTER.NUMBER.LEN])

   ROW<1,98>  = TRIM(LINE[OWNER.9.DOCUMENT.NUMBER.POS, OWNER.9.DOCUMENT.NUMBER.LEN])
   ROW<1,99>  = TRIM(LINE[OWNER.9.NAME.POS, OWNER.9.NAME.LEN])
   ROW<1,100> = TRIM(LINE[OWNER.9.NAME.FORMAT.POS, OWNER.9.NAME.FORMAT.LEN])
   ROW<1,101> = TRIM(LINE[OWNER.9.ADDRESS.POS, OWNER.9.ADDRESS.LEN])
   ROW<1,102> = TRIM(LINE[OWNER.9.CITY.POS, OWNER.9.CITY.LEN])
   ROW<1,103> = TRIM(LINE[OWNER.9.STATE.POS, OWNER.9.STATE.LEN])
   ROW<1,104> = TRIM(LINE[OWNER.9.ZIP.POS, OWNER.9.ZIP.LEN])
   ROW<1,105> = TRIM(LINE[OWNER.9.COUNTRY.POS, OWNER.9.COUNTRY.LEN])
   ROW<1,106> = TRIM(LINE[OWNER.9.FEI.NUMBER.POS, OWNER.9.FEI.NUMBER.LEN])
   ROW<1,107> = TRIM(LINE[OWNER.9.CHARTER.NUMBER.POS, OWNER.9.CHARTER.NUMBER.LEN])

   ROW<1,108> = TRIM(LINE[OWNER.10.DOCUMENT.NUMBER.POS, OWNER.10.DOCUMENT.NUMBER.LEN])
   ROW<1,109> = TRIM(LINE[OWNER.10.NAME.POS, OWNER.10.NAME.LEN])
   ROW<1,110> = TRIM(LINE[OWNER.10.NAME.FORMAT.POS, OWNER.10.NAME.FORMAT.LEN])
   ROW<1,111> = TRIM(LINE[OWNER.10.ADDRESS.POS, OWNER.10.ADDRESS.LEN])
   ROW<1,112> = TRIM(LINE[OWNER.10.CITY.POS, OWNER.10.CITY.LEN])
   ROW<1,113> = TRIM(LINE[OWNER.10.STATE.POS, OWNER.10.STATE.LEN])
   ROW<1,114> = TRIM(LINE[OWNER.10.ZIP.POS, OWNER.10.ZIP.LEN])
   ROW<1,115> = TRIM(LINE[OWNER.10.COUNTRY.POS, OWNER.10.COUNTRY.LEN])
   ROW<1,116> = TRIM(LINE[OWNER.10.FEI.NUMBER.POS, OWNER.10.FEI.NUMBER.LEN])
   ROW<1,117> = TRIM(LINE[OWNER.10.CHARTER.NUMBER.POS, OWNER.10.CHARTER.NUMBER.LEN])

   RETURN
END
